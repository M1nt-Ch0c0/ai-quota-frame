# 该程序只主动推图，不监听任何主机 HTTP 端口。

# CLIProxyAPI 管理 API 地址，建议仅绑定 localhost；该值只由主机服务使用，不会下发给相框。
CLIPROXY_BASE_URL=http://127.0.0.1:8317
CLIPROXY_MANAGEMENT_KEY=replace-with-your-cliproxy-management-key

# 主动把原始 PNG 推送到常亮 PhotoPainter；URL 与令牌必须同时配置。
# 推图码须为 32..128 个无空白可打印 ASCII 字节，且不得复用管理或用量采集密钥。
PHOTOFRAME_PUSH_URL=http://192.168.1.50/api/push
PHOTOFRAME_PUSH_TOKEN=replace-with-generated-token

# 画面显示的 OAuth 订阅类型，最多 5 行。默认：codex,xai,kimi（显示为 CODEX / GROK / KIMI）。
# 格式：id[+id...][:LABEL]，例如：
# DISPLAY_PROVIDERS=codex,claude,google
# DISPLAY_PROVIDERS=codex:CODEX,kimi:KIMI,gemini-cli+antigravity:GEMINI
# DISPLAY_PROVIDERS=codex,xai,kimi

# 可选：今日及近 7 日 token/费用统计（cpa-manager-plus）。
# CPAMP_BASE_URL=http://127.0.0.1:18317
# CPAMP_ADMIN_KEY=replace-with-your-cpamp-admin-key

# 可选：两个管理 API 位于 oauth2-proxy（Google 登录、接受 JWT bearer）之后且由网关注入
# 管理密钥时，改用 Google 服务账号 ID Token 鉴权；此时不需要上面两个管理密钥。
# 两个 BASE_URL 均指向网关的 HTTPS 地址；AUDIENCE 为 oauth2-proxy 的 client_id。
# GOOGLE_SERVICE_ACCOUNT_FILE=/private/path/service-account.json
# GOOGLE_ID_TOKEN_AUDIENCE=replace-with-oauth2-proxy-client-id.apps.googleusercontent.com

REFRESH_INTERVAL=5m
PASSIVE_MAX_AGE=24h
REQUEST_TIMEOUT=20s
MAX_CONCURRENCY=4
TZ=Asia/Shanghai

DEMO_MODE=false
