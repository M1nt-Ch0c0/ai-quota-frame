  "cards": [
    {
      "dot": "cyan",
      "title": "主机流水线",
      "items": [
        "后台循环每 5 分钟聚合各 provider 额度",
        "失败时保留历史最佳窗口并标记 STALE",
        "语义指纹不变则 ETag 稳定，相框不刷屏"
      ]
    },
    {
      "dot": "emerald",
      "title": "显示契约",
      "items": [
        "E6 全屏刷新约 25s 且不支持快刷",
        "ETag/304 是正确性约束而非优化",
        "固件深度睡眠，醒后按 URL 轮询"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "OAuth token 与 management key 不出主机",
        "非 loopback 明文 http 配置直接拒绝启动",
        "LAN 侧仅用独立 FRAME_ACCESS_TOKEN，错误即 401"
      ]
    }
  ]
