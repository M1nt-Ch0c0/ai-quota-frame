diff --git a/webapp/src/utils/deviceAuth.js b/webapp/src/utils/deviceAuth.js
new file mode 100644
index 0000000..12d1403
--- /dev/null
+++ b/webapp/src/utils/deviceAuth.js
@@ -0,0 +1,27 @@
+// Only same-origin device API calls receive the secret. Never attach it to
+// OpenAI/Google image requests or persist it in localStorage.
+export function installDeviceAuth(target = window) {
+  const originalFetch = target.fetch.bind(target);
+  let token = "";
+  target.fetch = async (input, init) => {
+    const request = new Request(
+      input instanceof Request ? input : new URL(input, target.location.origin),
+      init
+    );
+    const url = new URL(request.url);
+    if (url.origin !== target.location.origin || !url.pathname.startsWith("/api/")) {
+      return originalFetch(request);
+    }
+    const headers = new Headers(request.headers);
+    if (token) headers.set("Authorization", `Bearer ${token}`);
+    const response = await originalFetch(
+      new Request(request.clone(), { headers, redirect: "error" })
+    );
+    if (response.status !== 401) return response;
+    const entered = target.prompt("PhotoFrame authentication code (config/push-token.txt):");
+    if (!entered) return response;
+    token = entered.trim();
+    headers.set("Authorization", `Bearer ${token}`);
+    return originalFetch(new Request(request, { headers, redirect: "error" }));
+  };
+}
diff --git a/webapp/src/utils/deviceAuth.test.js b/webapp/src/utils/deviceAuth.test.js
new file mode 100644
index 0000000..395b00a
--- /dev/null
+++ b/webapp/src/utils/deviceAuth.test.js
@@ -0,0 +1,30 @@
+import { describe, it, expect, vi } from "vitest";
+import { installDeviceAuth } from "./deviceAuth";
+
+describe("device authentication", () => {
+  it("retries a 401 with the same body and never leaks the code to another origin", async () => {
+    const seen = [];
+    const target = {
+      location: { origin: "http://frame.local" },
+      prompt: vi.fn(() => "a".repeat(64)),
+      fetch: async (request) => {
+        seen.push({
+          url: request.url,
+          auth: request.headers.get("Authorization"),
+          body: await request.text(),
+        });
+        return new Response("", { status: seen.length === 1 ? 401 : 200 });
+      },
+    };
+    installDeviceAuth(target);
+    await target.fetch("/api/push", { method: "POST", body: "image bytes" });
+    await target.fetch("/api/config");
+    await target.fetch("https://api.example.com/image");
+    expect(seen[0].auth).toBeNull();
+    expect(seen[1].body).toBe("image bytes");
+    expect(seen[1].auth).toBe(`Bearer ${"a".repeat(64)}`);
+    expect(seen[2].auth).toBe(seen[1].auth);
+    expect(seen[3].auth).toBeNull();
+    expect(target.prompt).toHaveBeenCalledTimes(1);
+  });
+});
