diff --git a/main/wifi_profiles.c b/main/wifi_profiles.c
new file mode 100644
index 0000000..a4e291d
--- /dev/null
+++ b/main/wifi_profiles.c
@@ -0,0 +1,213 @@
+#include "wifi_profiles.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "cJSON.h"
+
+// cJSON's default recursion limit is much larger than the ESP task stack.
+// Our schema needs only object -> array -> object; reject deeper input first.
+static bool bounded_json_depth(const char *text)
+{
+    unsigned depth = 0;
+    bool quoted = false, escaped = false;
+    for (const char *p = text; *p; ++p) {
+        if (quoted) {
+            if (escaped)
+                escaped = false;
+            else if (*p == '\\')
+                escaped = true;
+            else if (*p == '"')
+                quoted = false;
+        } else if (*p == '"')
+            quoted = true;
+        else if (*p == '{' || *p == '[') {
+            if (++depth > 4)
+                return false;
+        } else if (*p == '}' || *p == ']') {
+            if (!depth)
+                return false;
+            --depth;
+        }
+    }
+    return !depth && !quoted;
+}
+
+bool wifi_profile_valid(const char *ssid, const char *password)
+{
+    if (!ssid || !password || !*ssid || strlen(ssid) > 32)
+        return false;
+    for (const unsigned char *p = (const unsigned char *) ssid; *p; ++p)
+        if (*p < 32 || *p == 127)
+            return false;
+    size_t n = strlen(password);
+    if (n && (n < 8 || n > 64))
+        return false;
+    for (size_t i = 0; i < n; ++i) {
+        unsigned char c = (unsigned char) password[i];
+        if (n == 64 ? !isxdigit(c) : (c < 32 || c > 126))
+            return false;
+    }
+    return true;
+}
+
+int wifi_profiles_try_connect(const wifi_profiles_t *profiles,
+                              bool (*connect)(const wifi_profile_t *, void *), void *context)
+{
+    if (!profiles || !connect || profiles->count > WIFI_PROFILE_LIMIT)
+        return -1;
+    for (size_t i = 0; i < profiles->count; ++i)
+        if (connect(&profiles->items[i], context))
+            return (int) i;
+    return -1;
+}
+
+wifi_profiles_result_t wifi_profiles_upsert(wifi_profiles_t *profiles, const char *ssid,
+                                            const char *password)
+{
+    if (!profiles || profiles->count > WIFI_PROFILE_LIMIT || !wifi_profile_valid(ssid, password))
+        return WIFI_PROFILES_INVALID;
+    size_t index = 0;
+    while (index < profiles->count && strcmp(profiles->items[index].ssid, ssid))
+        ++index;
+    if (index == WIFI_PROFILE_LIMIT)
+        return WIFI_PROFILES_FULL;
+    if (index == profiles->count)
+        ++profiles->count;
+    strcpy(profiles->items[index].ssid, ssid);
+    strcpy(profiles->items[index].password, password);
+    return WIFI_PROFILES_OK;
+}
+
+wifi_profiles_result_t wifi_profiles_load(const char *path, wifi_profiles_t *out)
+{
+    if (!path || !out)
+        return WIFI_PROFILES_INVALID;
+    memset(out, 0, sizeof(*out));
+    FILE *file = fopen(path, "rb");
+    if (!file && errno == ENOENT) {
+        char backup[256];
+        if (snprintf(backup, sizeof(backup), "%s.bak", path) >= (int) sizeof(backup))
+            return WIFI_PROFILES_INVALID;
+        file = fopen(backup, "rb");
+    }
+    if (!file)
+        return errno == ENOENT ? WIFI_PROFILES_NOT_FOUND : WIFI_PROFILES_IO;
+    char *text = calloc(8194, 1);
+    if (!text) {
+        fclose(file);
+        return WIFI_PROFILES_IO;
+    }
+    size_t len = fread(text, 1, 8193, file);
+    bool io_error = ferror(file);
+    fclose(file);
+    if (io_error || len > 8192 || strlen(text) != len || strstr(text, "\\u0000") ||
+        !bounded_json_depth(text)) {
+        free(text);
+        return io_error ? WIFI_PROFILES_IO : WIFI_PROFILES_INVALID;
+    }
+    cJSON *root = cJSON_ParseWithOpts(text, NULL, true);
+    free(text);
+    cJSON *version = cJSON_GetObjectItemCaseSensitive(root, "version");
+    cJSON *networks = cJSON_GetObjectItemCaseSensitive(root, "networks");
+    wifi_profiles_t parsed = {0};
+    bool valid = cJSON_IsNumber(version) && version->valuedouble == 1 && cJSON_IsArray(networks) &&
+                 cJSON_GetArraySize(networks) <= WIFI_PROFILE_LIMIT;
+    if (valid) {
+        cJSON *network;
+        cJSON_ArrayForEach(network, networks)
+        {
+            cJSON *ssid = cJSON_GetObjectItemCaseSensitive(network, "ssid");
+            cJSON *password = cJSON_GetObjectItemCaseSensitive(network, "password");
+            size_t previous = parsed.count;
+            if (!cJSON_IsString(ssid) || !cJSON_IsString(password) ||
+                wifi_profiles_upsert(&parsed, ssid->valuestring, password->valuestring) !=
+                    WIFI_PROFILES_OK ||
+                parsed.count != previous + 1) {
+                valid = false;
+                break;
+            }
+        }
+    }
+    cJSON_Delete(root);
+    if (!valid)
+        return WIFI_PROFILES_INVALID;
+    *out = parsed;
+    return WIFI_PROFILES_OK;
+}
+
+wifi_profiles_result_t wifi_profiles_save(const char *path, const wifi_profiles_t *profiles)
+{
+    if (!path || !profiles || profiles->count > WIFI_PROFILE_LIMIT)
+        return WIFI_PROFILES_INVALID;
+    char temporary[256], backup[256];
+    if (snprintf(temporary, sizeof(temporary), "%s.tmp", path) >= (int) sizeof(temporary) ||
+        snprintf(backup, sizeof(backup), "%s.bak", path) >= (int) sizeof(backup))
+        return WIFI_PROFILES_INVALID;
+    cJSON *root = cJSON_CreateObject();
+    if (!root)
+        return WIFI_PROFILES_IO;
+    cJSON *networks = cJSON_AddArrayToObject(root, "networks");
+    bool valid = networks && cJSON_AddNumberToObject(root, "version", 1);
+    for (size_t i = 0; valid && i < profiles->count; ++i) {
+        const wifi_profile_t *p = &profiles->items[i];
+        if (!wifi_profile_valid(p->ssid, p->password)) {
+            cJSON_Delete(root);
+            return WIFI_PROFILES_INVALID;
+        }
+        for (size_t j = 0; j < i; ++j)
+            if (!strcmp(p->ssid, profiles->items[j].ssid)) {
+                cJSON_Delete(root);
+                return WIFI_PROFILES_INVALID;
+            }
+        cJSON *item = cJSON_CreateObject();
+        if (!item) {
+            valid = false;
+            break;
+        }
+        cJSON_AddItemToArray(networks, item);
+        valid = cJSON_AddStringToObject(item, "ssid", p->ssid) &&
+                cJSON_AddStringToObject(item, "password", p->password);
+    }
+    char *text = valid ? cJSON_PrintUnformatted(root) : NULL;
+    cJSON_Delete(root);
+    if (!text)
+        return WIFI_PROFILES_IO;
+    FILE *file = fopen(temporary, "wb");
+    if (!file) {
+        free(text);
+        return WIFI_PROFILES_IO;
+    }
+    bool ok = fwrite(text, 1, strlen(text), file) == strlen(text);
+    free(text);
+    if (fflush(file) || fsync(fileno(file)))
+        ok = false;
+    if (fclose(file))
+        ok = false;
+    if (!ok) {
+        unlink(temporary);
+        return WIFI_PROFILES_IO;
+    }
+    // FAT rename may not replace existing files. Keep a recoverable previous
+    // generation until the new file has been published; boot can read .bak.
+    if (access(path, F_OK) == 0) {
+        if (unlink(backup) && errno != ENOENT) {
+            unlink(temporary);
+            return WIFI_PROFILES_IO;
+        }
+        if (rename(path, backup)) {
+            unlink(temporary);
+            return WIFI_PROFILES_IO;
+        }
+    }
+    if (rename(temporary, path)) {
+        unlink(temporary);
+        return WIFI_PROFILES_IO;
+    }
+    unlink(backup);
+    return WIFI_PROFILES_OK;
+}
