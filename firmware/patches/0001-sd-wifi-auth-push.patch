diff --git a/host_tests/test_api_guard.cpp b/host_tests/test_api_guard.cpp
new file mode 100644
index 0000000..ffdb392
--- /dev/null
+++ b/host_tests/test_api_guard.cpp
@@ -0,0 +1,101 @@
+#include <gtest/gtest.h>
+
+#include <cstring>
+#include <string>
+extern "C" {
+#include "api_guard.h"
+#include "push_auth.h"
+}
+static httpd_uri_t installed;
+static bool configured;
+static int calls;
+static std::string response_status;
+static bool closed;
+extern "C" {
+bool push_auth_enabled(void)
+{
+    return configured;
+}
+bool push_auth_matches(const char *header)
+{
+    return !strcmp(header, "Bearer valid-code");
+}
+esp_err_t httpd_register_uri_handler(httpd_handle_t, const httpd_uri_t *route)
+{
+    installed = *route;
+    return ESP_OK;
+}
+esp_err_t httpd_req_get_hdr_value_str(httpd_req_t *req, const char *, char *out, size_t len)
+{
+    if (!req->test_auth || strlen(req->test_auth) >= len)
+        return ESP_FAIL;
+    strcpy(out, req->test_auth);
+    return ESP_OK;
+}
+esp_err_t httpd_resp_set_status(httpd_req_t *, const char *value)
+{
+    response_status = value;
+    return ESP_OK;
+}
+esp_err_t httpd_resp_set_hdr(httpd_req_t *, const char *key, const char *value)
+{
+    if (!strcmp(key, "Connection") && !strcmp(value, "close"))
+        closed = true;
+    return ESP_OK;
+}
+esp_err_t httpd_resp_sendstr(httpd_req_t *, const char *)
+{
+    return ESP_OK;
+}
+}
+static esp_err_t inner(httpd_req_t *req)
+{
+    ++calls;
+    EXPECT_EQ(req->user_ctx, &calls);
+    return ESP_OK;
+}
+static void run(const char *path, httpd_method_t method, const char *authorization)
+{
+    api_guard_reset();
+    calls = 0;
+    response_status.clear();
+    closed = false;
+    httpd_uri_t route = {path, method, inner, &calls};
+    ASSERT_EQ(api_guard_register_uri(nullptr, &route), ESP_OK);
+    httpd_req_t req = {path, method, installed.user_ctx, authorization};
+    installed.handler(&req);
+}
+
+TEST(ApiGuard, AllMutationPathsAndSecretReadsRejectBeforeHandler)
+{
+    configured = true;
+    for (auto path : {"/api/push", "/api/rotate", "/api/display-image", "/api/config",
+                      "/api/ota/update", "/api/factory-reset"}) {
+        for (auto header : {static_cast<const char *>(nullptr), "Bearer wrong", ""}) {
+            run(path, HTTP_POST, header);
+            EXPECT_EQ(calls, 0) << path;
+            EXPECT_EQ(response_status, "401 Unauthorized");
+            EXPECT_TRUE(closed);
+        }
+        run(path, HTTP_POST, "Bearer valid-code");
+        EXPECT_EQ(calls, 1) << path;
+    }
+    run("/api/config", HTTP_GET, nullptr);
+    EXPECT_EQ(calls, 0);
+    run("/api/debug/log", HTTP_GET, nullptr);
+    EXPECT_EQ(calls, 0);
+}
+
+TEST(ApiGuard, PushDisabledWithoutSecretAndReadOnlyImageStillWorks)
+{
+    configured = false;
+    run("/api/push", HTTP_POST, "Bearer valid-code");
+    EXPECT_EQ(calls, 0);
+    EXPECT_EQ(response_status, "503 Service Unavailable");
+    configured = true;
+    run("/api/current_image", HTTP_GET, nullptr);
+    EXPECT_EQ(calls, 1);
+    std::string oversized(200, 'a');
+    run("/api/push", HTTP_POST, oversized.c_str());
+    EXPECT_EQ(calls, 0);
+}
diff --git a/host_tests/test_push_auth.cpp b/host_tests/test_push_auth.cpp
new file mode 100644
index 0000000..617981e
--- /dev/null
+++ b/host_tests/test_push_auth.cpp
@@ -0,0 +1,111 @@
+#include <gtest/gtest.h>
+
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+extern "C" {
+#include "nvs.h"
+#include "push_auth.h"
+#include "storage.h"
+}
+
+static std::string saved;
+static storage_type_t medium;
+static esp_err_t save_error;
+extern "C" {
+esp_err_t nvs_open(const char *, int, nvs_handle_t *out)
+{
+    *out = 1;
+    return ESP_OK;
+}
+esp_err_t nvs_get_str(nvs_handle_t, const char *, char *out, size_t *size)
+{
+    if (saved.empty())
+        return ESP_ERR_NVS_NOT_FOUND;
+    if (*size <= saved.size())
+        return ESP_ERR_INVALID_SIZE;
+    strcpy(out, saved.c_str());
+    return ESP_OK;
+}
+esp_err_t nvs_set_str(nvs_handle_t, const char *, const char *value)
+{
+    if (save_error)
+        return save_error;
+    saved = value;
+    return ESP_OK;
+}
+esp_err_t nvs_commit(nvs_handle_t)
+{
+    return ESP_OK;
+}
+void nvs_close(nvs_handle_t) {}
+storage_type_t storage_get_type(void)
+{
+    return medium;
+}
+}
+
+class PushAuth : public ::testing::Test
+{
+   protected:
+    const std::string code = std::string(64, 'a');
+    void SetUp() override
+    {
+        saved.clear();
+        medium = STORAGE_TYPE_SDCARD;
+        save_error = ESP_OK;
+        std::filesystem::create_directories("pf_auth_storage/config");
+    }
+    void TearDown() override
+    {
+        std::filesystem::remove_all("pf_auth_storage");
+    }
+    void write(const std::string &value)
+    {
+        std::ofstream("pf_auth_storage/config/push-token.txt", std::ios::binary) << value;
+    }
+};
+
+TEST_F(PushAuth, MissingSecretNeverAuthenticates)
+{
+    ASSERT_EQ(push_auth_init(), ESP_OK);
+    EXPECT_FALSE(push_auth_enabled());
+    EXPECT_FALSE(push_auth_matches("Bearer "));
+    EXPECT_FALSE(push_auth_matches(nullptr));
+}
+
+TEST_F(PushAuth, ProvisionRotateAndRebootWithoutCard)
+{
+    write(code + "\r\n");
+    ASSERT_EQ(push_auth_init(), ESP_OK);
+    EXPECT_TRUE(push_auth_enabled());
+    EXPECT_TRUE(push_auth_matches(("Bearer " + code).c_str()));
+    EXPECT_FALSE(push_auth_matches(("Bearer " + code + "x").c_str()));
+    EXPECT_FALSE(push_auth_matches(("Bearer " + std::string(64, 'b')).c_str()));
+    EXPECT_FALSE(push_auth_matches(code.c_str()));
+    medium = STORAGE_TYPE_NONE;
+    ASSERT_EQ(push_auth_init(), ESP_OK);
+    EXPECT_TRUE(push_auth_matches(("Bearer " + code).c_str()));
+    medium = STORAGE_TYPE_SDCARD;
+    write(std::string(128, 'b'));
+    ASSERT_EQ(push_auth_init(), ESP_OK);
+    EXPECT_FALSE(push_auth_matches(("Bearer " + code).c_str()));
+    EXPECT_TRUE(push_auth_matches(("Bearer " + std::string(128, 'b')).c_str()));
+}
+
+TEST_F(PushAuth, MalformedSecretAndPersistenceFailureLockDown)
+{
+    for (const auto &value : {std::string("short"), std::string(129, 'a'), code + "\nother",
+                              code + std::string(1, '\0')}) {
+        write(value);
+        EXPECT_NE(push_auth_init(), ESP_OK);
+        EXPECT_TRUE(push_auth_enabled());
+        EXPECT_FALSE(push_auth_matches(("Bearer " + code).c_str()));
+    }
+    save_error = ESP_FAIL;
+    write(code);
+    EXPECT_NE(push_auth_init(), ESP_OK);
+    EXPECT_TRUE(push_auth_enabled());
+    EXPECT_FALSE(push_auth_matches(("Bearer " + code).c_str()));
+}
diff --git a/host_tests/test_wifi_profiles.cpp b/host_tests/test_wifi_profiles.cpp
new file mode 100644
index 0000000..456b339
--- /dev/null
+++ b/host_tests/test_wifi_profiles.cpp
@@ -0,0 +1,114 @@
+#include <gtest/gtest.h>
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+extern "C" {
+#include "wifi_profiles.h"
+}
+
+class WifiProfiles : public ::testing::Test
+{
+   protected:
+    std::string dir, path;
+    void SetUp() override
+    {
+        char name[] = "/tmp/pf-wifi-XXXXXX";
+        dir = mkdtemp(name);
+        path = dir + "/wifi.json";
+    }
+    void TearDown() override
+    {
+        std::filesystem::remove_all(dir);
+    }
+};
+
+TEST_F(WifiProfiles, MultipleNetworksSurviveReloadAndUpdate)
+{
+    wifi_profiles_t profiles = {}, rebooted = {};
+    ASSERT_EQ(wifi_profiles_load(path.c_str(), &profiles), WIFI_PROFILES_NOT_FOUND);
+    ASSERT_EQ(wifi_profiles_upsert(&profiles, "home", "password-one"), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_upsert(&profiles, "office", "password-two"), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_save(path.c_str(), &profiles), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_load(path.c_str(), &rebooted), WIFI_PROFILES_OK);
+    ASSERT_EQ(rebooted.count, 2u);
+    EXPECT_STREQ(rebooted.items[0].ssid, "home");
+    EXPECT_STREQ(rebooted.items[1].password, "password-two");
+    ASSERT_EQ(wifi_profiles_upsert(&rebooted, "home", "replacement"), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_save(path.c_str(), &rebooted), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_load(path.c_str(), &profiles), WIFI_PROFILES_OK);
+    EXPECT_EQ(profiles.count, 2u);
+    EXPECT_STREQ(profiles.items[0].password, "replacement");
+    EXPECT_FALSE(std::filesystem::exists(path + ".tmp"));
+}
+
+TEST_F(WifiProfiles, BoundsAndFullListAreNotSilentlyTruncated)
+{
+    wifi_profiles_t profiles = {};
+    EXPECT_TRUE(wifi_profile_valid(std::string(32, 's').c_str(), std::string(64, 'a').c_str()));
+    EXPECT_FALSE(wifi_profile_valid(std::string(33, 's').c_str(), "password"));
+    EXPECT_FALSE(wifi_profile_valid("home", "short"));
+    EXPECT_FALSE(wifi_profile_valid("home", std::string(64, 'z').c_str()));
+    EXPECT_TRUE(wifi_profile_valid("open wifi", ""));
+    for (int i = 0; i < WIFI_PROFILE_LIMIT; ++i)
+        ASSERT_EQ(wifi_profiles_upsert(&profiles, std::to_string(i).c_str(), "password"),
+                  WIFI_PROFILES_OK);
+    EXPECT_EQ(wifi_profiles_upsert(&profiles, "extra", "password"), WIFI_PROFILES_FULL);
+    EXPECT_EQ(profiles.count, WIFI_PROFILE_LIMIT);
+}
+
+TEST_F(WifiProfiles, BootSelectionFallsBackInPriorityOrderAndStopsOnSuccess)
+{
+    wifi_profiles_t profiles = {};
+    for (const char *ssid : {"unreachable", "office", "backup"})
+        ASSERT_EQ(wifi_profiles_upsert(&profiles, ssid, "password"), WIFI_PROFILES_OK);
+    struct Trial {
+        std::vector<std::string> calls;
+        bool success;
+    } trial = {{}, true};
+    auto connect = [](const wifi_profile_t *profile, void *arg) {
+        auto *trial = static_cast<Trial *>(arg);
+        trial->calls.push_back(profile->ssid);
+        return trial->success && trial->calls.back() == "office";
+    };
+    EXPECT_EQ(wifi_profiles_try_connect(&profiles, connect, &trial), 1);
+    EXPECT_EQ(trial.calls, (std::vector<std::string>{"unreachable", "office"}));
+    trial = {{}, false};
+    EXPECT_EQ(wifi_profiles_try_connect(&profiles, connect, &trial), -1);
+    EXPECT_EQ(trial.calls.size(), 3u);
+    EXPECT_EQ(profiles.count, 3u);
+}
+
+TEST_F(WifiProfiles, MalformedDuplicatesOversizeAndEmbeddedNullRejected)
+{
+    for (
+        const auto &body :
+        {std::string("not json"),
+         std::string(
+             R"({"version":1,"networks":[{"ssid":"x","password":"password"},{"ssid":"x","password":"password"}]})"),
+         std::string(R"({"version":1,"networks":[{"ssid":"x\u0000y","password":"password"}]})"),
+         std::string(8193, ' '), std::string(R"({"version":1,"networks":[],"bad":[[[[[]]]]]})"),
+         std::string(R"({"version":2,"networks":[]})")}) {
+        std::ofstream(path, std::ios::binary) << body;
+        wifi_profiles_t profiles = {};
+        EXPECT_EQ(wifi_profiles_load(path.c_str(), &profiles), WIFI_PROFILES_INVALID);
+        EXPECT_EQ(profiles.count, 0u);
+    }
+}
+
+TEST_F(WifiProfiles, RecoverInterruptedFatRenameAndRetainExplicitEmptyList)
+{
+    wifi_profiles_t profiles = {}, loaded = {};
+    ASSERT_EQ(wifi_profiles_upsert(&profiles, "home", "password"), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_save(path.c_str(), &profiles), WIFI_PROFILES_OK);
+    std::filesystem::rename(path, path + ".bak");
+    ASSERT_EQ(wifi_profiles_load(path.c_str(), &loaded), WIFI_PROFILES_OK);
+    EXPECT_EQ(loaded.count, 1u);
+    profiles.count = 0;
+    ASSERT_EQ(wifi_profiles_save(path.c_str(), &profiles), WIFI_PROFILES_OK);
+    ASSERT_EQ(wifi_profiles_load(path.c_str(), &loaded), WIFI_PROFILES_OK);
+    EXPECT_EQ(loaded.count, 0u);
+    EXPECT_EQ(wifi_profiles_save((dir + "/missing/wifi.json").c_str(), &profiles),
+              WIFI_PROFILES_IO);
+}
