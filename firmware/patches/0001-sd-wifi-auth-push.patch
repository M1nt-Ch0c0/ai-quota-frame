diff --git a/main/api_guard.c b/main/api_guard.c
new file mode 100644
index 0000000..90e7e14
--- /dev/null
+++ b/main/api_guard.c
@@ -0,0 +1,65 @@
+#include "api_guard.h"
+
+#include <string.h>
+
+#include "push_auth.h"
+typedef struct {
+    esp_err_t (*handler)(httpd_req_t *);
+    void *user_ctx;
+} secured_route_t;
+static secured_route_t secured_routes[64];
+static size_t secured_route_count;
+
+static esp_err_t secured_handler(httpd_req_t *req)
+{
+    secured_route_t *route = req->user_ctx;
+    if (!push_auth_enabled() && !strcmp(req->uri, "/api/push")) {
+        httpd_resp_set_status(req, "503 Service Unavailable");
+        httpd_resp_set_hdr(req, "Connection", "close");
+        httpd_resp_sendstr(req, "Push authentication is not configured");
+        return ESP_FAIL;
+    }
+    if (push_auth_enabled()) {
+        char authorization[144] = {0};
+        if (httpd_req_get_hdr_value_str(req, "Authorization", authorization,
+                                        sizeof(authorization)) != ESP_OK ||
+            !push_auth_matches(authorization)) {
+            // The body has not been read. Close instead of treating it as the
+            // next keep-alive request; unauthorized clients never touch storage.
+            httpd_resp_set_status(req, "401 Unauthorized");
+            httpd_resp_set_hdr(req, "WWW-Authenticate", "Bearer realm=\"PhotoFrame\"");
+            httpd_resp_set_hdr(req, "Connection", "close");
+            httpd_resp_sendstr(req, "Authentication required");
+            return ESP_FAIL;
+        }
+    }
+    req->user_ctx = route->user_ctx;
+    esp_err_t err = route->handler(req);
+    req->user_ctx = route;
+    return err;
+}
+
+esp_err_t api_guard_register_uri(httpd_handle_t handle, const httpd_uri_t *uri)
+{
+    // Protect every state-changing API, including legacy display/rotate/config/
+    // OTA/factory-reset paths, so the new push endpoint cannot be bypassed.
+    bool protect = !strncmp(uri->uri, "/api/", 5) &&
+                   (uri->method != HTTP_GET || !strcmp(uri->uri, "/api/config") ||
+                    !strncmp(uri->uri, "/api/debug", 10));
+    if (!protect)
+        return httpd_register_uri_handler(handle, uri);
+    if (secured_route_count >= sizeof(secured_routes) / sizeof(secured_routes[0]))
+        return ESP_ERR_NO_MEM;
+    secured_route_t *route = &secured_routes[secured_route_count++];
+    route->handler = uri->handler;
+    route->user_ctx = uri->user_ctx;
+    httpd_uri_t copy = *uri;
+    copy.handler = secured_handler;
+    copy.user_ctx = route;
+    return httpd_register_uri_handler(handle, &copy);
+}
+
+void api_guard_reset(void)
+{
+    secured_route_count = 0;
+}
