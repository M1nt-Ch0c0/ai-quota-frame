diff --git a/main/push_auth.c b/main/push_auth.c
new file mode 100644
index 0000000..a14adaf
--- /dev/null
+++ b/main/push_auth.c
@@ -0,0 +1,98 @@
+#include "push_auth.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "config.h"
+#include "nvs.h"
+#include "storage.h"
+
+static char token[129];
+static bool enabled;
+static bool valid_token(const char *value)
+{
+    size_t len = strlen(value);
+    if (len < 32 || len > 128)
+        return false;
+    for (size_t i = 0; i < len; ++i)
+        if ((unsigned char) value[i] < 33 || (unsigned char) value[i] > 126)
+            return false;
+    return true;
+}
+
+esp_err_t push_auth_init(void)
+{
+    enabled = false;
+    memset(token, 0, sizeof(token));
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        enabled = true;
+        return err;
+    }
+    size_t size = sizeof(token);
+    err = nvs_get_str(handle, "push_token", token, &size);
+    if (err != ESP_ERR_NVS_NOT_FOUND)
+        enabled = true;
+    if (err != ESP_OK && err != ESP_ERR_NVS_NOT_FOUND) {
+        nvs_close(handle);
+        return err;
+    }
+    if (storage_get_type() == STORAGE_TYPE_SDCARD) {
+        FILE *file = fopen(FS_MOUNT_POINT "/config/push-token.txt", "rb");
+        if (file) {
+            enabled = true;
+            char incoming[132] = {0};
+            size_t len = fread(incoming, 1, sizeof(incoming) - 1, file);
+            bool failed = ferror(file) || !feof(file);
+            fclose(file);
+            while (len && (incoming[len - 1] == '\n' || incoming[len - 1] == '\r'))
+                incoming[--len] = 0;
+            if (failed || strlen(incoming) != len || !valid_token(incoming)) {
+                memset(token, 0, sizeof(token));
+                nvs_close(handle);
+                return ESP_ERR_INVALID_ARG;
+            }
+            err = nvs_set_str(handle, "push_token", incoming);
+            if (err == ESP_OK)
+                err = nvs_commit(handle);
+            if (err != ESP_OK) {
+                memset(token, 0, sizeof(token));
+                nvs_close(handle);
+                return err;
+            }
+            strcpy(token, incoming);
+        } else if (errno != ENOENT) {
+            enabled = true;
+            memset(token, 0, sizeof(token));
+            nvs_close(handle);
+            return ESP_FAIL;
+        }
+    }
+    nvs_close(handle);
+    if (enabled && !valid_token(token)) {
+        memset(token, 0, sizeof(token));
+        return ESP_ERR_INVALID_ARG;
+    }
+    return ESP_OK;
+}
+
+bool push_auth_enabled(void)
+{
+    return enabled;
+}
+
+bool push_auth_matches(const char *authorization)
+{
+    if (!enabled || !valid_token(token) || !authorization || strncmp(authorization, "Bearer ", 7))
+        return false;
+    const char *provided = authorization + 7;
+    size_t len = strlen(token);
+    if (strlen(provided) != len)
+        return false;
+    volatile unsigned char difference = 0;
+    for (size_t i = 0; i < len; ++i)
+        difference |= token[i] ^ provided[i];
+    return difference == 0;
+}
